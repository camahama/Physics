{
  "name": "physics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/landing",
    "apps/electricity",
    "apps/thermodynamics",
    "apps/mechanics",
    "apps/rainbow/src/rainbow_web",
    "apps/sundial"
  ],
  "scripts": {
    "dev": "npm --workspace @physics/landing run dev",
    "dev:landing": "npm --workspace @physics/landing run dev",
    "dev:electricity": "npm --workspace @physics/electricity run dev",
    "dev:thermodynamics": "npm --workspace @physics/thermodynamics run dev",
    "dev:mechanics": "npm --workspace @physics/mechanics run dev",
    "dev:rainbow": "npm --workspace @physics/rainbow run dev",
    "build": "npm run build:landing && npm run build:electricity && npm run build:thermodynamics && npm run build:mechanics && npm run build:rainbow && npm run build:sundial && npm run assemble",
    "build:landing": "npm --workspace @physics/landing run build",
    "build:electricity": "npm --workspace @physics/electricity run build",
    "build:thermodynamics": "npm --workspace @physics/thermodynamics run build",
    "build:mechanics": "npm --workspace @physics/mechanics run build",
    "build:rainbow": "npm --workspace @physics/rainbow run build",
    "assemble": "node scripts/assemble-dist.mjs",
    "preview": "npm --workspace @physics/landing run preview",
    "dev:sundial": "npm --workspace @physics/sundial run dev",
    "build:sundial": "npm --workspace @physics/sundial run build"
  }
}
